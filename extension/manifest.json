{
  "manifest_version": 3,
  "name": "NJK - YT-downloader",
  "version": "1.2",
  "description": "Personal local download helper for YouTube. Adds a Download button next to Like/Share that talks to a local server on your machine.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:9999/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}